# ==========================================
# AURA DISCORD BOT & DASHBOARD CONFIGURATION
# ==========================================

# 1. BOT CREDENTIALS (from https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_CLIENT_SECRET=your_client_secret_here

# 2. BOT DEFAULTS
BOT_PREFIX=+
DEFAULT_EMBED_COLOR=#9333ea

# 3. DATABASE (MongoDB Connection URI)
# Local: mongodb://localhost:27017/aura_bot
# Atlas: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/aura_bot?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/aura_bot

# 4. SERVER & DASHBOARD
PORT=5000
NODE_ENV=development
SESSION_SECRET=aura_super_secure_random_session_secret_change_me_12345

# 5. OAUTH2 REDIRECT URLS
# Must match Redirects in Discord Developer Portal -> OAuth2 -> General
# Development: http://localhost:5000/api/auth/callback
# Production: https://yourdomain.com/api/auth/callback
DISCORD_REDIRECT_URI=http://localhost:5000/api/auth/callback
DASHBOARD_URL=http://localhost:5173

# 6. OPTIONAL BOT BRANDING FALLBACK
BOT_AVATAR_FALLBACK=https://cdn.discordapp.com/embed/avatars/0.png
